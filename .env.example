# Copy to .dev.vars for local Wrangler, or configure the same names in Cloudflare.
# Never expose the service-role key to the browser or commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
# Used only by local Drizzle migration commands, not by the Worker runtime.
SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
BOOTSTRAP_TOKEN=REPLACE_WITH_CRYPTOGRAPHIC_RANDOM_VALUE
SITE_HOST=inchouf.com
VARELYS_ADMIN_EMAIL=varelysperfumes@gmail.com
# Set locally only. Do not commit the real password.
VARELYS_ADMIN_PASSWORD=REPLACE_WITH_OWNER_PASSWORD
# The Worker keeps the existing private R2 FILES binding.
